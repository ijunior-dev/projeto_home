# Copie este arquivo para .env e preencha os valores antes de rodar a aplicação.

# Chave secreta para assinar tokens JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# URL de conexão com o banco PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase local (usado pelo server.py)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=

# Origens permitidas pelo CORS (separadas por vírgula). Deixe vazio para bloquear todas.
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit do endpoint /auth/token (ex: "5/minute", "100/hour")
LOGIN_RATE_LIMIT=5/minute
